# Port the web app listens on (plain http).
ATSUIT_PORT=8080
# Optional https front end (docker compose --profile tls up -d).
ATSUIT_TLS_PORT=8443
# The address laptops use to reach this server, e.g. 10.100.70.101
ATSUIT_TLS_HOST=localhost
# Public base URL, used in links handed to old kiosk agents.
ATSUIT_PUBLIC_URL=
# Speech recognition: 1 = on, 0 = off. ATSUIT_WITH_ASR=0 builds a smaller image without it.
ATSUIT_ASR=1
ATSUIT_WITH_ASR=1
# How many rooms can be captioned at once (0 = one per CPU core).
ATSUIT_ASR_MAX_ROOMS=0
# User the server SSHes in as for older kiosk agents.
ATSUIT_FLEET_SSH_USER=adam
TZ=Europe/London
# Set by install.sh --pull to run the published image instead of building locally.
# ATSUIT_IMAGE=ghcr.io/adam1991tom/at-suit:latest
